# Set this to the final GitHub Pages or custom-domain URL before building.
# Its path is also used as the asset base, so project pages work below /repository-name/.
SITE_URL=https://lucasalme1da.github.io/figma-simple-timelines/

# Optional override for the default Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7C9VET7EY9

# Optional ownership tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
